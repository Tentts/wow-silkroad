# Packaging for CurseForge and GitHub releases (BigWigsMods/packager).
# The addon lives in SilkRoad/; the zip must contain only that folder.

package-as: SilkRoad

# Lift the addon folder to the top of the zip (SilkRoad/SilkRoad -> SilkRoad).
move-folders:
  SilkRoad/SilkRoad: SilkRoad

# Development files that never go into the zip (dotfiles are skipped automatically).
ignore:
  - AGENTS.md
  - CHANGELOG.md
  - DEV.md
  - README.md
  - docs
  - media
  - scripts
  - tests
  - tools

# Release notes: the whole of CHANGELOG.md, written by hand for each release
# (only the version being released). Commit messages are never used.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
