# Libraries (skipped automatically when another addon loaded the same or newer version)
Libs\LibStub\LibStub.lua
Libs\LibAHTab\LibAHTab.lua

# Localization (must load before SilkRoad's own files: they all read SR.L)
Locales\enUS.lua

# Core: namespace, game-version ("flavor") detection, events, slash commands
