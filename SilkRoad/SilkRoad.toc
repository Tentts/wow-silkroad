# Game-version layer: each file returns early unless it matches SR.flavor
Game\Forever.lua
Data\Forever\Recipes.lua

# Core services (version-agnostic)
Core\Util.lua
Core\Database.lua
Core\Prices.lua
Core\Sources.lua
Core\Recipes.lua
Core\Merchants.lua
Core\AuctionScanner.lua

# UI framework
UI\Widgets.lua
UI\DataTable.lua
UI\MainFrame.lua
UI\Launcher.lua
UI\OptionsPanel.lua
UI\AuctionHouseTab.lua
UI\SourcePopup.lua

# Pages (menus), shown in the sidebar in their registered order
